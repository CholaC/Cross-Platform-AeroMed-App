NODE_ENV=development
PORT=3000
DB_PATH=./data/skymed.db
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:8080
PYTHON=python3
# simulation is default; no messages leave this server
DELIVERY_MODE=simulation
# Live mode: controlled provider relay; HTTPS and idempotency support required
SMS_RELAY_URL=
SMS_RELAY_TOKEN=
FCM_PROJECT_ID=
# Short-lived OAuth access token; replace with managed refresh for long-running deployment
FCM_ACCESS_TOKEN=
# Required for the USSD webhook in NODE_ENV=production
USSD_GATEWAY_SECRET=
